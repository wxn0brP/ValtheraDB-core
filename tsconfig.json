{
	"compilerOptions": {
		"module": "ES2022",
		"target": "ES2022",
		"moduleResolution": "bundler",
		"paths": {},
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "./dist",
		"declaration": true,
		"rootDir": "./src",
		"strict": false,
        "strictNullChecks": true
	},
	"include": [
		"./src"
	],
	"exclude": [
		"node_modules"
	],
	"tsc-alias": {
		"resolveFullPaths": true,
		"verbose": false
	}
}
